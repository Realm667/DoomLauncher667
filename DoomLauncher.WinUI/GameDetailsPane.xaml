<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DoomLauncher.WinUI.GameDetailsPane"
    x:Name="DetailsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" /><Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Border
        Background="{StaticResource DoomSurfaceBrush}"
        BorderBrush="{StaticResource DoomStrokeBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Grid x:Name="DetailsLayout">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="DetailsScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16" Spacing="12">
                <Border
                    x:Name="ArtworkFrame" Height="180"
                    Background="{StaticResource DoomSurfaceElevatedBrush}"
                    CornerRadius="10">
                    <Grid>
                        <Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding ViewModel.SelectedGame.CurrentImage, ElementName=DetailsRoot}"
                            ImageFailed="Artwork_ImageFailed"
                            Stretch="{Binding ViewModel.SelectedGame.CurrentImageStretch, ElementName=DetailsRoot}" />
                        <Button
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding PreviousImage}"
                            Click="PreviousImageButton_Click"
                            Visibility="{Binding ViewModel.SelectedGame.SliderVisibility, ElementName=DetailsRoot}">
                            <FontIcon Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding NextImage}"
                            Click="NextImageButton_Click"
                            Visibility="{Binding ViewModel.SelectedGame.SliderVisibility, ElementName=DetailsRoot}">
                            <FontIcon Glyph="&#xE76C;" />
                        </Button>
                        <Border
                            Margin="0,0,8,8"
                            Padding="8,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#B0000000"
                            CornerRadius="9"
                            Visibility="{Binding ViewModel.SelectedGame.SliderVisibility, ElementName=DetailsRoot}">
                            <TextBlock
                                FontSize="11"
                                Text="{Binding ViewModel.SelectedGame.ImageCounter, ElementName=DetailsRoot}" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock
                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                        FontSize="23"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="{Binding ViewModel.SelectedGame.Title, ElementName=DetailsRoot}" Text="{Binding ViewModel.SelectedGame.Title, ElementName=DetailsRoot}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.SelectedGame.Subtitle, ElementName=DetailsRoot}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Padding="10,5"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="12">
                        <TextBlock
                            FontSize="12"
                            Text="{Binding ViewModel.SelectedGame.Category, ElementName=DetailsRoot}" />
                    </Border>
                    <Border
                        Padding="10,5"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="12">
                        <TextBlock
                            FontSize="12"
                            Text="{Binding ViewModel.SelectedGame.Year, ElementName=DetailsRoot}" />
                    </Border>
                </StackPanel>

                <Grid x:Name="LaunchDefinitionSummary" ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding SourcePort}" />
                        <Button
                                AutomationProperties.Name="{Binding SourcePort}" ToolTipService.ToolTip="{Binding LaunchOptions}"
                                Click="ChooseLaunchDefinition_Click">
                            <TextBlock Text="{Binding ViewModel.SelectedGame.SourcePort, ElementName=DetailsRoot}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ViewModel.SelectedGame.SourcePort, ElementName=DetailsRoot}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Iwad}" />
                        <Button
                                AutomationProperties.Name="{Binding Iwad}" ToolTipService.ToolTip="{Binding LaunchOptions}"
                                Click="ChooseLaunchDefinition_Click">
                            <TextBlock Text="{Binding ViewModel.SelectedGame.Iwad, ElementName=DetailsRoot}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ViewModel.SelectedGame.Iwad, ElementName=DetailsRoot}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Playtime}" />
                        <TextBlock Text="{Binding ViewModel.SelectedGame.Playtime, ElementName=DetailsRoot}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding LastPlayed}" />
                        <TextBlock Text="{Binding ViewModel.SelectedGame.LastPlayed, ElementName=DetailsRoot}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ViewModel.LaunchSetupHint, ElementName=DetailsRoot}" TextWrapping="Wrap"
                           Visibility="{Binding ViewModel.LaunchSetupHintVisibility, ElementName=DetailsRoot}" />

                <Grid x:Name="PersonalRatingRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PersonalRatingLabel" Text="{Binding PersonalRating}" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                    <RatingControl x:Name="PersonalRatingStars" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        MaxRating="5" IsClearEnabled="True" AutomationProperties.Name="{Binding PersonalRating}"
                        IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}"
                        Value="{Binding ViewModel.PersonalRatingValue, ElementName=DetailsRoot, Mode=OneWay}"
                        ValueChanged="PersonalRating_Changed" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{Binding ViewModel.FavoriteButtonText, ElementName=DetailsRoot}"
                        Click="FavoriteButton_Click"
                        IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}">
                        <Grid ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="14"
                                Foreground="{StaticResource DoomAccentBrush}"
                                Glyph="{Binding ViewModel.FavoriteGlyph, ElementName=DetailsRoot}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.FavoriteButtonText, ElementName=DetailsRoot}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{Binding ViewModel.FinishedButtonText, ElementName=DetailsRoot}"
                        Click="FinishedButton_Click"
                        IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}">
                        <Grid ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource DoomSuccessBrush}"
                                Glyph="{Binding ViewModel.FinishedGlyph, ElementName=DetailsRoot}" />
                            <TextBlock Grid.Column="1" Text="{Binding ViewModel.FinishedButtonText, ElementName=DetailsRoot}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>

                <Grid x:Name="CollectionActionsRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="PlayLaterButton"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="{Binding ViewModel.QueueActionText, ElementName=DetailsRoot}"
                        Click="QueueButton_Click"
                        IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}"
                        ToolTipService.ToolTip="{Binding ViewModel.QueueActionText, ElementName=DetailsRoot}">
                        <TextBlock
                            Text="{Binding ViewModel.QueueActionText, ElementName=DetailsRoot}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>
                    <Button
                        x:Name="AddToCollectionButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="{Binding ManageCollections}"
                        Click="ManageCollectionsButton_Click"
                        IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}"
                        ToolTipService.ToolTip="{Binding ManageCollections}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock Grid.Column="1" Text="{Binding ManageCollections}" TextAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </Grid>


                <StackPanel Spacing="6">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="21"
                        Text="{Binding ViewModel.SelectedGame.DescriptionPreview, ElementName=DetailsRoot}"
                        TextWrapping="Wrap" />
                    <Button
                        Padding="0,4"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ReadMoreButton_Click"
                        Content="{Binding ReadMore}"
                        Foreground="{ThemeResource DoomControlAccentBrush}"
                        Visibility="{Binding ViewModel.SelectedGame.ReadMoreVisibility, ElementName=DetailsRoot}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Tags}" />
                    <TextBlock
                        Text="{Binding ViewModel.SelectedGame.TagsText, ElementName=DetailsRoot}"
                        TextWrapping="Wrap" />
                </StackPanel>




                <Expander x:Name="EntryToolsExpander" Header="{Binding EntryTools}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                    <StackPanel Spacing="8">
                <Button
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding EditEntry}"
                    Click="EditButton_Click"
                    IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        <TextBlock Text="{Binding EditEntry}" />
                    </StackPanel>
                </Button>

                <Button
                    HorizontalAlignment="Stretch"
                    AutomationProperties.HelpText="{Binding RescrapeIdGamesToolTip}"
                    x:Name="RefreshModMetadataButton"
                    AutomationProperties.Name="{Binding RescrapeIdGames}"
                    Click="RescrapeIdGamesButton_Click"
                    IsEnabled="{Binding ViewModel.CanRefreshModMetadata, ElementName=DetailsRoot}"
                    ToolTipService.ToolTip="{Binding RescrapeIdGamesToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE71C;" />
                        <TextBlock Text="{Binding RescrapeIdGames}" />
                    </StackPanel>
                </Button>

                <Button x:Name="MapsProgressButton" Content="{Binding ViewModel.MapsActionText, ElementName=DetailsRoot}" Click="MapsButton_Click" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="MapProgressSummary" Text="{Binding ViewModel.SelectedMapProgressText, ElementName=DetailsRoot}" Visibility="{Binding ViewModel.MapProgressVisibility, ElementName=DetailsRoot}" Style="{StaticResource MetaTextStyle}" />
                <Button Content="{Binding SaveGames}" Click="SavesButton_Click" HorizontalAlignment="Stretch" />
                <Button Content="{Binding MetadataHistory}" Click="HistoryButton_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="LaunchFooter" Grid.Row="1" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DoomStrokeBrush}" Background="{ThemeResource DoomSurfaceBrush}">
                <Grid x:Name="PrimaryLaunchRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{Binding Play}"
                        Click="PlayButton_Click"
                        IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}"
                        x:Name="PrimaryPlayButton" MinHeight="44" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{Binding ViewModel.IsLaunching, ElementName=DetailsRoot}"
                                Visibility="{Binding ViewModel.LaunchingVisibility, ElementName=DetailsRoot}" />
                            <TextBlock Text="{Binding ViewModel.LaunchButtonText, ElementName=DetailsRoot}" />
                        </StackPanel>
                    </Button>
                    <DropDownButton
                        Grid.Column="1"
                        AutomationProperties.Name="{Binding LaunchOptions}"
                        Click="LaunchOptionsButton_Click"
                        IsEnabled="{Binding ViewModel.CanLaunch, ElementName=DetailsRoot}"
                        ToolTipService.ToolTip="{Binding LaunchOptions}">
                        <DropDownButton.Content>
                            <FontIcon Glyph="&#xE713;" />
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <Flyout x:Name="LaunchOptionsFlyout">
                                <StackPanel x:Name="LaunchOptionsContent" Width="300" Spacing="12">
                                    <Grid>
                                        <TextBlock
                                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{Binding LaunchOptions}" />
                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Right"
                                            IsActive="{x:Bind ViewModel.IsLaunchOptionsLoading, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.LaunchOptionsLoadingVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <ComboBox
                                        AutomationProperties.Name="{Binding SourcePort}"
                                        DisplayMemberPath="Name"
                                        Header="{Binding SourcePort}"
                                        ItemsSource="{x:Bind ViewModel.SourcePortOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedSourcePortOption, Mode=TwoWay}" />
                                    <ComboBox
                                        AutomationProperties.Name="{Binding Iwad}"
                                        DisplayMemberPath="Name"
                                        Header="{Binding Iwad}"
                                        ItemsSource="{x:Bind ViewModel.IwadOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedIwadOption, Mode=TwoWay}" />
                                    <ComboBox
                                        AutomationProperties.Name="{Binding Map}"
                                        DisplayMemberPath="Name"
                                        Header="{Binding Map}"
                                        ItemsSource="{x:Bind ViewModel.MapOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedMapOption, Mode=TwoWay}" />
                                    <ComboBox
                                        AutomationProperties.Name="{Binding Difficulty}"
                                        DisplayMemberPath="Name"
                                        Header="{Binding Difficulty}"
                                        ItemsSource="{x:Bind ViewModel.SkillOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedSkillOption, Mode=TwoWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Content="{Binding SaveLaunchChoices}"
                                        Click="SaveLaunchChoices_Click"
                                        IsEnabled="{x:Bind ViewModel.CanLaunchWithOptions, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{Binding LaunchWithSelection}"
                                        Click="LaunchWithOptionsButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanLaunchWithOptions, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                                            <TextBlock Text="{Binding LaunchWithSelection}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
        </Border>
        </Grid>
    </Border>
</UserControl>
