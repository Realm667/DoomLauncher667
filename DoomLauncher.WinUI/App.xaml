<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DoomLauncher.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DoomLauncher.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF28A1A0" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF208887" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF1A7473" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF28A1A0" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF28A1A0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF28A1A0" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF208887" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF1A7473" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF28A1A0" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF28A1A0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF28A1A0" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF208887" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF1A7473" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF28A1A0" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF28A1A0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="DoomBodyFontFamily">ms-appx:///Assets/Fonts/TitilliumWeb-Light.ttf#Titillium Web</FontFamily>
            <FontFamily x:Key="DoomHeadlineFontFamily">ms-appx:///Assets/Fonts/TitilliumWeb-SemiBold.ttf#Titillium Web</FontFamily>

            <SolidColorBrush x:Key="DoomPageBackgroundBrush" Color="#FF111114" />
            <SolidColorBrush x:Key="DoomAccentBrush" Color="#E35D44" />
            <SolidColorBrush x:Key="DoomAccentForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DoomAccentSecondaryBrush" Color="#F07860" />
            <SolidColorBrush x:Key="DoomSurfaceBrush" Color="#E61B1B1F" />
            <SolidColorBrush x:Key="DoomSidebarBrush" Color="#FF0E0E11" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF0E0E11" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF0E0E11" />
            <SolidColorBrush x:Key="DoomSurfaceElevatedBrush" Color="#F02A2A30" />
            <SolidColorBrush x:Key="DoomStrokeBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="DoomSubtleStrokeBrush" Color="#20FFFFFF" />
            <!-- Bootstrap values only. ThemeManager replaces these resources
                 from the selected Data\Themes XML definition at runtime. -->
            <SolidColorBrush x:Key="DoomControlAccentBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="DoomControlAccentForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DoomControlAccentLowBrush" Color="#3328A1A0" />
            <SolidColorBrush x:Key="DoomControlAccentMediumBrush" Color="#4428A1A0" />
            <SolidColorBrush x:Key="DoomControlAccentStrongBrush" Color="#DD28A1A0" />
            <SolidColorBrush x:Key="DoomSuccessBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="DoomSuccessLowBrush" Color="#246CCB5F" />
            <SolidColorBrush x:Key="DoomWarningBrush" Color="#FFE35D44" />
            <Color x:Key="DoomControlAccentLowColor">#3328A1A0</Color>
            <Color x:Key="DoomControlAccentMediumColor">#4428A1A0</Color>
            <Color x:Key="DoomSuccessColor">#FF6CCB5F</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF208887" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF1A7473" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="TextSelectionHighlightColorThemeBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF208887" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FF1A7473" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#FF208887" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF208887" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF1A7473" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF208887" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF1A7473" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF28A1A0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF208887" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF1A7473" />

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DoomHeadlineFontFamily}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DoomBodyFontFamily}" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DoomBodyFontFamily}" />
                <Setter Property="FontWeight" Value="Light" />
            </Style>

            <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
