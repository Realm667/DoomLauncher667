<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DoomLauncher.WinUI.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DoomLauncher.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DoomLauncher.WinUI.Models"
    AllowDrop="True"
    Background="{StaticResource DoomPageBackgroundBrush}"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    RequestedTheme="Dark"
    mc:Ignorable="d">
    <Page.Resources>
        <models:ListColumnLayout x:Key="ListColumnLayout" />
        <models:ListColumnLayout x:Key="CollectionListColumnLayout" />
        <models:ListDensityLayout x:Key="ListDensityLayout" />
        <models:AccordionDensityLayout x:Key="AccordionDensityLayout" />
        <models:TileLayout x:Key="TileLayout" />
        <MenuFlyout
            x:Key="LibraryItemContextMenu"
            Opening="LibraryItemContextMenu_Opening">
            <MenuFlyoutItem Click="ContextFavorite_Click" />
            <MenuFlyoutItem Click="ContextFinished_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="ContextCollections_Click" />
            <MenuFlyoutItem Click="ContextEdit_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="ContextDelete_Click" />
        </MenuFlyout>
        <Style x:Key="RoundedTileItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Border
                            x:Name="SelectionChrome"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="Transparent" />
                            </Border.Background>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="SelectionChrome"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#22FFFFFF"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="SelectionChrome"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="{ThemeResource DoomControlAccentLowColor}"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="SelectionChrome"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="{ThemeResource DoomControlAccentLowColor}"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="SelectionChrome"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="{ThemeResource DoomControlAccentMediumColor}"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShowcaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="HomeSpotlightTemplate" x:DataType="models:LibraryItem">
            <Button
                Height="173"
                Click="OverviewButton_Click"
                ContextFlyout="{StaticResource LibraryItemContextMenu}"
                Style="{StaticResource ShowcaseButtonStyle}"
                Tag="{x:Bind Self}">
                <Grid>
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{x:Bind Artwork}"
                        Stretch="{x:Bind ArtworkStretch}" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.2" Color="#16000000" />
                                <GradientStop Offset="1" Color="#E6000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel
                        Margin="18"
                        VerticalAlignment="Bottom"
                        Spacing="2">
                        <TextBlock
                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="#CCFFFFFF"
                            MaxLines="1"
                            Text="{x:Bind Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,12,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border
                            Width="28"
                            Height="28"
                            Background="{ThemeResource DoomControlAccentBrush}"
                            CornerRadius="14"
                            Visibility="{x:Bind FavoriteBadgeVisibility, Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Glyph="&#xE735;" />
                        </Border>
                        <Border
                            Width="28"
                            Height="28"
                            Background="{ThemeResource DoomSuccessBrush}"
                            CornerRadius="14"
                            Visibility="{x:Bind FinishedBadgeVisibility, Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Glyph="&#xE73E;" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="LibraryTileTemplate" x:DataType="models:LibraryItem">
            <Border
                Width="{Binding CardWidth, Source={StaticResource TileLayout}}"
                Height="{Binding CardHeight, Source={StaticResource TileLayout}}"
                ContextFlyout="{StaticResource LibraryItemContextMenu}"
                Opacity="{x:Bind FinishedOpacity, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ToolTipService.ToolTip="{x:Bind Title}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding ArtworkHeight, Source={StaticResource TileLayout}}" />
                        <RowDefinition Height="112" />
                    </Grid.RowDefinitions>
                    <Border
                        Margin="1"
                        CornerRadius="11,11,0,0">
                        <Border.Background>
                            <ImageBrush
                                AlignmentX="Center"
                                AlignmentY="Center"
                                ImageSource="{x:Bind Artwork}"
                                Stretch="{x:Bind ArtworkStretch}" />
                        </Border.Background>
                        <Grid>
                            <StackPanel
                                Margin="0,0,8,8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Border
                                    Width="30"
                                    Height="30"
                                    Background="{ThemeResource DoomControlAccentBrush}"
                                    CornerRadius="15"
                                    Visibility="{x:Bind FavoriteBadgeVisibility, Mode=OneWay}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Glyph="&#xE735;" />
                                </Border>
                                <Border
                                    Width="30"
                                    Height="30"
                                    Background="{ThemeResource DoomSuccessBrush}"
                                    CornerRadius="15"
                                    Visibility="{x:Bind FinishedBadgeVisibility, Mode=OneWay}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Glyph="&#xE73E;" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="12,9,12,10" RowSpacing="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            VerticalAlignment="Top"
                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="{x:Bind Title}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource MetaTextStyle}"
                            Text="{x:Bind Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource MetaTextStyle}"
                            Text="{x:Bind Meta}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CollectionListRowTemplate" x:DataType="models:LibraryItem">
            <Grid
                MinHeight="{Binding RowMinHeight, Source={StaticResource ListDensityLayout}}"
                Padding="{Binding LibraryRowPadding, Source={StaticResource ListDensityLayout}}"
                ContextFlyout="{StaticResource LibraryItemContextMenu}"
                ColumnSpacing="0"
                Loaded="CollectionColumnGrid_Loaded"
                Opacity="{x:Bind FinishedOpacity, Mode=OneWay}"
                Tag="CollectionColumnGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ArtworkWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding TitleWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding AuthorWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding ReleaseDateWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding MapsWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding RatingWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding DownloadedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding SourcePortWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding PlaytimeWidth, Source={StaticResource CollectionListColumnLayout}}" />
                    <ColumnDefinition Width="{Binding FinishedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="{Binding ArtworkWidth, Source={StaticResource ListDensityLayout}}"
                    Height="{Binding ArtworkHeight, Source={StaticResource ListDensityLayout}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="7">
                    <Border.Background>
                        <ImageBrush
                            AlignmentX="Center"
                            AlignmentY="Center"
                            ImageSource="{x:Bind Artwork}"
                            Stretch="{x:Bind ArtworkStretch}" />
                    </Border.Background>
                </Border>
                <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" FontFamily="{StaticResource DoomHeadlineFontFamily}" FontSize="12" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Author}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding ReleaseDate, Mode=OneWay}" />
                <TextBlock Grid.Column="4" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Maps}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Rating}" />
                <TextBlock Grid.Column="6" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Downloaded, Mode=OneWay}" />
                <TextBlock Grid.Column="7" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind SourcePort}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="8" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Playtime}" />
                <CheckBox
                    Grid.Column="9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="FinishedCheckBox_Click"
                    IsChecked="{x:Bind IsFinished, Mode=OneWay}"
                    Tag="{x:Bind GameFileId}">
                    <CheckBox.Resources>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource DoomSuccessColor}" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource DoomSuccessColor}" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource DoomSuccessColor}" />
                    </CheckBox.Resources>
                </CheckBox>
            </Grid>
        </DataTemplate>
        <Style x:Key="TableHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="False"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="224"
        PaneDisplayMode="Left"
        FontFamily="{StaticResource DoomBodyFontFamily}"
        FontWeight="Light"
        SelectionChanged="ShellNavigation_SelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Margin="8,16,8,18" Orientation="Horizontal" Spacing="12">
                <Image
                    Width="52"
                    Height="52"
                    Source="Assets/logo_alpha_small_cropped.png"
                    Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                        FontWeight="SemiBold"
                        Text="DOOM LAUNCHER 667" />
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding ModLibrary}" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.PaneFooter>
            <Border
                Margin="8,8,8,4"
                Padding="12"
                Background="{StaticResource DoomSurfaceBrush}"
                CornerRadius="10">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{Binding LibraryStatistics}" />
                    <Grid ColumnSpacing="8" RowSpacing="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Mods}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalEntriesValue, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource MetaTextStyle}" Text="{Binding Maps}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.TotalMapsValue, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource MetaTextStyle}" Text="{Binding TotalPlayedHours}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.TotalPlayedHoursValue, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource MetaTextStyle}" Text="{Binding PlayedMods}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.PlayedEntriesValue, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource MetaTextStyle}" Text="{Binding UnplayedMods}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.UnplayedEntriesValue, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource MetaTextStyle}" Text="{Binding FinishedEntries}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.FinishedEntriesValue, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </NavigationView.PaneFooter>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="{Binding Home}" Icon="Home" Tag="Home" />
            <NavigationViewItem
                Content="{Binding Library}"
                Icon="Library"
                IsSelected="True"
                Tag="Library" />
            <NavigationViewItem Content="{Binding Collections}" Icon="Folder" Tag="Collections" />
            <NavigationViewItem Content="{Binding Discover}" Icon="World" Tag="Discover" />
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="{Binding Favorites}" Icon="Favorite" Tag="Favorites" />
            <NavigationViewItem Content="{Binding Recent}" Icon="Clock" Tag="Recent" />
            <NavigationViewItem Content="{Binding Downloads}" Icon="Download" Tag="Downloads" />
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="{Binding Achievements}" Tag="Achievements">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7E7;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge
                        Value="{x:Bind ViewModel.UnseenAchievementCount, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.AchievementBadgeVisibility, Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="DebugNavigationItem"
                Content="{Binding Debug}"
                Tag="Debug"
                Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEBE8;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="{Binding Settings}" Icon="Setting" Tag="Settings" />
            <NavigationViewItem
                Content="{Binding LauncherDefinitions}"
                Tag="LauncherDefinitions">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE90F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Padding="28,18,28,24" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Style="{StaticResource SectionTitleStyle}"
                        Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource MetaTextStyle}"
                        Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                    TextChanged="SearchBox_TextChanged">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Invoked="SearchAccelerator_Invoked"
                            Key="F"
                            Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="{Binding ImportTooltip}"
                        Click="ImportButton_Click"
                        ToolTipService.ToolTip="{Binding ImportTooltip}">
                        <FontIcon Glyph="&#xE8E5;" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="I" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        AutomationProperties.Name="{Binding ImportBundle}"
                        Click="ImportBundleButton_Click"
                        ToolTipService.ToolTip="{Binding ImportBundle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE896;" />
                            <TextBlock Text="{Binding ImportPackageShort}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{Binding ExportBundle}"
                        Click="ExportBundleButton_Click"
                        ToolTipService.ToolTip="{Binding ExportBundle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE898;" />
                            <TextBlock Text="{Binding ExportPackageShort}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{Binding ClassicTooltip}"
                        Click="OpenClassicButton_Click"
                        ToolTipService.ToolTip="{Binding ClassicTooltip}">
                        <FontIcon Glyph="&#xE7C8;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{Binding RefreshTooltip}"
                        Click="RefreshButton_Click"
                        ToolTipService.ToolTip="{Binding RefreshTooltip}">
                        <FontIcon Glyph="&#xE72C;" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="16"
                Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel
                        x:Name="CategoryFilterPanel"
                        Orientation="Horizontal">
                        <ToggleButton
                            x:Name="AllFilterButton"
                            Click="CategoryFilter_Click"
                            IsChecked="True"
                            Style="{StaticResource PillToggleStyle}"
                            Tag="All"
                            Content="{Binding All}" />
                        <ToggleButton
                            x:Name="IwadFilterButton"
                            Click="CategoryFilter_Click"
                            Style="{StaticResource PillToggleStyle}"
                            Tag="Iwads"
                            Content="{Binding Iwads}" />
                        <ToggleButton
                            x:Name="ModsFilterButton"
                            Click="CategoryFilter_Click"
                            Style="{StaticResource PillToggleStyle}"
                            Tag="Mods"
                            Content="{Binding Mods}" />
                        <ToggleButton
                            x:Name="UnplayedFilterButton"
                            Click="CategoryFilter_Click"
                            Style="{StaticResource PillToggleStyle}"
                            Tag="Unplayed"
                            Content="{Binding Unplayed}" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        x:Name="SortOrderBox"
                        Width="170"
                        Height="40"
                        AutomationProperties.Name="{Binding SortLibrary}"
                        PlaceholderText="{Binding SortOrderPlaceholder}"
                        SelectedIndex="-1"
                        SelectionChanged="SortOrderBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding Title}" Tag="Title" />
                        <ComboBoxItem Content="{Binding Author}" Tag="Author" />
                        <ComboBoxItem Content="{Binding ReleaseDate}" Tag="ReleaseDate" />
                        <ComboBoxItem Content="{Binding Rating}" Tag="Rating" />
                        <ComboBoxItem Content="{Binding LastPlayed}" Tag="LastPlayed" />
                        <ComboBoxItem Content="{Binding Playtime}" Tag="Playtime" />
                        <ComboBoxItem Content="{Binding Finished}" Tag="Finished" />
                        <ComboBoxItem Content="{Binding Year}" Tag="Year" />
                    </ComboBox>
                    <DropDownButton
                        Width="58"
                        Height="40"
                        Padding="9,0"
                        AutomationProperties.Name="{Binding Columns}"
                        ToolTipService.ToolTip="{Binding Columns}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="17"
                            Glyph="&#xE8A9;" />
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="ArtworkColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Artwork" Text="{Binding Artwork}" />
                                <ToggleMenuFlyoutItem x:Name="TitleColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Title" Text="{Binding Title}" />
                                <ToggleMenuFlyoutItem x:Name="AuthorColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Author" Text="{Binding Author}" />
                                <ToggleMenuFlyoutItem x:Name="ReleaseDateColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="ReleaseDate" Text="{Binding ReleaseDate}" />
                                <ToggleMenuFlyoutItem x:Name="MapsColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Maps" Text="{Binding Maps}" />
                                <ToggleMenuFlyoutItem x:Name="RatingColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Rating" Text="{Binding Rating}" />
                                <ToggleMenuFlyoutItem x:Name="DownloadedColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Downloaded" Text="{Binding Downloaded}" />
                                <ToggleMenuFlyoutItem x:Name="SourcePortColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="SourcePort" Text="{Binding SourcePort}" />
                                <ToggleMenuFlyoutItem x:Name="PlaytimeColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Playtime" Text="{Binding Playtime}" />
                                <ToggleMenuFlyoutItem x:Name="FinishedColumnItem" Click="ColumnToggle_Click" IsChecked="True" Tag="Finished" Text="{Binding Finished}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        x:Name="ViewModeButton"
                        Width="42"
                        AutomationProperties.Name="{Binding GridActivation}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ViewModeButton_Click"
                        ToolTipService.ToolTip="{Binding ListView}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Button.Resources>
                        <FontIcon x:Name="ViewModeIcon" Glyph="&#xE8FD;" />
                    </Button>
                    <Slider
                        x:Name="LibraryTileSizeSlider"
                        Width="120"
                        AutomationProperties.Name="{Binding TileSize}"
                        IsEnabled="False"
                        Maximum="280"
                        Minimum="144"
                        StepFrequency="8"
                        ToolTipService.ToolTip="{Binding TileSize}"
                        Value="{Binding CardWidth, Source={StaticResource TileLayout}, Mode=OneWay}"
                        ValueChanged="TileSizeSlider_ValueChanged" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                HorizontalAlignment="Right"
                Visibility="{x:Bind ViewModel.CollectionsVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="NewCollectionButton"
                        Height="40"
                        Padding="14,6"
                        AutomationProperties.Name="{Binding NewCollection}"
                        Click="NewCollectionButton_Click"
                        ToolTipService.ToolTip="{Binding NewCollection}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE710;" />
                            <TextBlock Text="{Binding NewCollection}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CollapseAllCollectionsButton"
                        Height="40"
                        Padding="14,6"
                        AutomationProperties.Name="{Binding CollapseAllCollections}"
                        Click="CollapseAllCollectionsButton_Click"
                        Content="{Binding CollapseAllCollections}"
                        ToolTipService.ToolTip="{Binding CollapseAllCollections}" />
                    <ComboBox
                        x:Name="CollectionSortOrderBox"
                        Width="170"
                        Height="40"
                        AutomationProperties.Name="{Binding SortLibrary}"
                        PlaceholderText="{Binding SortOrderPlaceholder}"
                        SelectedIndex="-1"
                        SelectionChanged="CollectionSortOrderBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding Title}" Tag="Title" />
                        <ComboBoxItem Content="{Binding Author}" Tag="Author" />
                        <ComboBoxItem Content="{Binding ReleaseDate}" Tag="ReleaseDate" />
                        <ComboBoxItem Content="{Binding Maps}" Tag="Maps" />
                        <ComboBoxItem Content="{Binding Rating}" Tag="Rating" />
                        <ComboBoxItem Content="{Binding Downloaded}" Tag="Downloaded" />
                        <ComboBoxItem Content="{Binding Playtime}" Tag="Playtime" />
                        <ComboBoxItem Content="{Binding Finished}" Tag="Finished" />
                    </ComboBox>
                    <DropDownButton
                        x:Name="CollectionColumnsButton"
                        Width="58"
                        Height="40"
                        Padding="9,0"
                        AutomationProperties.Name="{Binding Columns}"
                        ToolTipService.ToolTip="{Binding Columns}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="17"
                            Glyph="&#xE8A9;" />
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="CollectionArtworkColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Artwork" Text="{Binding Artwork}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionTitleColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Title" Text="{Binding Title}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionAuthorColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Author" Text="{Binding Author}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionReleaseDateColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="ReleaseDate" Text="{Binding ReleaseDate}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionMapsColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Maps" Text="{Binding Maps}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionRatingColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Rating" Text="{Binding Rating}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionDownloadedColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Downloaded" Text="{Binding Downloaded}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionSourcePortColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="SourcePort" Text="{Binding SourcePort}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionPlaytimeColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Playtime" Text="{Binding Playtime}" />
                                <ToggleMenuFlyoutItem x:Name="CollectionFinishedColumnItem" Click="CollectionColumnToggle_Click" IsChecked="True" Tag="Finished" Text="{Binding Finished}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        x:Name="CollectionsViewModeButton"
                        Width="44"
                        AutomationProperties.Name="{Binding GridActivation}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CollectionsViewModeButton_Click"
                        ToolTipService.ToolTip="{Binding GridActivation}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Button.Resources>
                        <FontIcon
                            x:Name="CollectionsViewModeIcon"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE8FD;" />
                    </Button>
                    <Slider
                        x:Name="CollectionTileSizeSlider"
                        Width="120"
                        AutomationProperties.Name="{Binding TileSize}"
                        Maximum="280"
                        Minimum="144"
                        StepFrequency="8"
                        ToolTipService.ToolTip="{Binding TileSize}"
                        Value="{Binding CardWidth, Source={StaticResource TileLayout}, Mode=OneWay}"
                        ValueChanged="TileSizeSlider_ValueChanged" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="2"
                ColumnSpacing="20"
                Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <GridView
                        x:Name="GameGrid"
                        Visibility="Collapsed"
                        ItemContainerStyle="{StaticResource RoundedTileItemStyle}"
                        ItemTemplate="{StaticResource LibraryTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                        SelectionChanged="GameGrid_SelectionChanged"
                        SelectionMode="Single">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemHeight="{Binding PanelItemHeight, Source={StaticResource TileLayout}}"
                                    ItemWidth="{Binding PanelItemWidth, Source={StaticResource TileLayout}}"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <Grid x:Name="ListViewHost">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer
                            x:Name="HeaderScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            ViewChanged="HeaderScrollViewer_ViewChanged">
                            <Grid
                                MinHeight="38"
                                Padding="8,0"
                                ColumnSpacing="0"
                                Background="{StaticResource DoomSurfaceElevatedBrush}"
                                Loaded="LibraryColumnGrid_Loaded"
                                Tag="LibraryColumnGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ArtworkWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding TitleWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding AuthorWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding ReleaseDateWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding MapsWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding RatingWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding DownloadedWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding SourcePortWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding PlaytimeWidth, Source={StaticResource ListColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding FinishedWidth, Source={StaticResource ListColumnLayout}}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Artwork}" />
                                <Button x:Name="TitleHeader" Grid.Column="1" Click="ColumnHeader_Click" Content="{Binding Title}" Style="{StaticResource TableHeaderButtonStyle}" Tag="Title" />
                                <Button x:Name="AuthorHeader" Grid.Column="2" Click="ColumnHeader_Click" Content="{Binding Author}" Style="{StaticResource TableHeaderButtonStyle}" Tag="Author" />
                                <Button x:Name="ReleaseDateHeader" Grid.Column="3" Click="ColumnHeader_Click" Content="{Binding ReleaseDate}" Style="{StaticResource TableHeaderButtonStyle}" Tag="ReleaseDate" />
                                <Button x:Name="MapsHeader" Grid.Column="4" Click="ColumnHeader_Click" Content="{Binding Maps}" Style="{StaticResource TableHeaderButtonStyle}" Tag="Maps" />
                                <Button x:Name="RatingHeader" Grid.Column="5" Click="ColumnHeader_Click" Content="{Binding Rating}" Style="{StaticResource TableHeaderButtonStyle}" Tag="Rating" />
                                <Button x:Name="DownloadedHeader" Grid.Column="6" Click="ColumnHeader_Click" Content="{Binding Downloaded}" Style="{StaticResource TableHeaderButtonStyle}" Tag="Downloaded" />
                                <Button x:Name="SourcePortHeader" Grid.Column="7" Click="ColumnHeader_Click" Content="{Binding SourcePort}" Style="{StaticResource TableHeaderButtonStyle}" Tag="SourcePort" />
                                <Button x:Name="PlaytimeHeader" Grid.Column="8" Click="ColumnHeader_Click" Content="{Binding Playtime}" Style="{StaticResource TableHeaderButtonStyle}" Tag="Playtime" />
                                <Button x:Name="FinishedHeader" Grid.Column="9" Click="ColumnHeader_Click" Content="{Binding Finished}" Style="{StaticResource TableHeaderButtonStyle}" Tag="Finished" />
                            </Grid>
                        </ScrollViewer>
                        <ListView
                            x:Name="GameList"
                            Grid.Row="1"
                            AutomationProperties.Name="{Binding ListAutomation}"
                            HorizontalContentAlignment="Left"
                            ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                            SelectionChanged="GameList_SelectionChanged"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ListViewItemPresenter
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                                    ContentMargin="0"
                                                    CornerRadius="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                                                    PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                                    SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                                    SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                                                    SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                                                    SelectionIndicatorBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                                    SelectionIndicatorPointerOverBrush="{ThemeResource ListViewItemSelectionIndicatorPointerOverBrush}"
                                                    SelectionIndicatorPressedBrush="{ThemeResource ListViewItemSelectionIndicatorPressedBrush}"
                                                    SelectionIndicatorVisualEnabled="True"
                                                    VerticalContentAlignment="Center" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LibraryItem">
                                    <Grid
                                        MinHeight="{Binding RowMinHeight, Source={StaticResource ListDensityLayout}}"
                                        Padding="{Binding LibraryRowPadding, Source={StaticResource ListDensityLayout}}"
                                        ContextFlyout="{StaticResource LibraryItemContextMenu}"
                                        ColumnSpacing="0"
                                        Loaded="LibraryColumnGrid_Loaded"
                                        Tag="LibraryColumnGrid"
                                        Opacity="{x:Bind FinishedOpacity, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ArtworkWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding TitleWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding AuthorWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding ReleaseDateWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding MapsWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding RatingWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding DownloadedWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding SourcePortWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding PlaytimeWidth, Source={StaticResource ListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding FinishedWidth, Source={StaticResource ListColumnLayout}}" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="{Binding ArtworkWidth, Source={StaticResource ListDensityLayout}}"
                                            Height="{Binding ArtworkHeight, Source={StaticResource ListDensityLayout}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="7">
                                            <Border.Background>
                                                <ImageBrush
                                                    AlignmentX="Center"
                                                    AlignmentY="Center"
                                                    ImageSource="{x:Bind Artwork}"
                                                    Stretch="{x:Bind ArtworkStretch}" />
                                            </Border.Background>
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="7,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Author}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding ReleaseDate, Mode=OneWay}" />
                                        <TextBlock Grid.Column="4" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Maps}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Rating}" />
                                        <TextBlock Grid.Column="6" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Downloaded, Mode=OneWay}" />
                                        <TextBlock Grid.Column="7" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind SourcePort}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="8" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Playtime}" />
                                        <CheckBox
                                            Grid.Column="9"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="FinishedCheckBox_Click"
                                            IsChecked="{x:Bind IsFinished, Mode=OneWay}"
                                            Tag="{x:Bind GameFileId}">
                                            <CheckBox.Resources>
                                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource DoomSuccessColor}" />
                                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource DoomSuccessColor}" />
                                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource DoomSuccessColor}" />
                                            </CheckBox.Resources>
                                        </CheckBox>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ProgressRing
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />

                    <StackPanel
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="34"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8F1;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{Binding NoEntries}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Column="1"
                    Background="{StaticResource DoomSurfaceBrush}"
                    BorderBrush="{StaticResource DoomStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <ScrollViewer>
                        <StackPanel Margin="20" Spacing="18">
                            <Border
                                Height="232"
                                Background="{StaticResource DoomSurfaceElevatedBrush}"
                                CornerRadius="10">
                                <Grid>
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind ViewModel.SelectedGame.CurrentImage, Mode=OneWay}"
                                        Stretch="{x:Bind ViewModel.SelectedGame.CurrentImageStretch, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding PreviousImage}"
                                        Click="PreviousImageButton_Click"
                                        Visibility="{x:Bind ViewModel.SelectedGame.SliderVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE76B;" />
                                    </Button>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding NextImage}"
                                        Click="NextImageButton_Click"
                                        Visibility="{x:Bind ViewModel.SelectedGame.SliderVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE76C;" />
                                    </Button>
                                    <Border
                                        Margin="0,0,8,8"
                                        Padding="8,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#B0000000"
                                        CornerRadius="9"
                                        Visibility="{x:Bind ViewModel.SelectedGame.SliderVisibility, Mode=OneWay}">
                                        <TextBlock FontSize="11" Text="{x:Bind ViewModel.SelectedGame.ImageCounter, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                    FontSize="25"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.SelectedGame.Title, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SelectedGame.Subtitle, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="10,5"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    CornerRadius="12">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource DoomControlAccentForegroundBrush}"
                                        Text="{x:Bind ViewModel.SelectedGame.Category, Mode=OneWay}" />
                                </Border>
                                <Border
                                    Padding="10,5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="12">
                                    <TextBlock
                                        FontSize="12"
                                        Text="{x:Bind ViewModel.SelectedGame.Year, Mode=OneWay}" />
                                </Border>
                            </StackPanel>

                            <Button
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.FavoriteButtonText, Mode=OneWay}"
                                Click="FavoriteButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{StaticResource DoomAccentBrush}"
                                        Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.FavoriteButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.FinishedButtonText, Mode=OneWay}"
                                Click="FinishedButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource DoomSuccessBrush}"
                                        Glyph="{x:Bind ViewModel.FinishedGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.FinishedButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{Binding EditEntry}"
                                Click="EditButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    <TextBlock Text="{Binding EditEntry}" />
                                </StackPanel>
                            </Button>

                            <Button
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{Binding ManageCollections}"
                                Click="ManageCollectionsButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                    <TextBlock Text="{Binding ManageCollections}" />
                                </StackPanel>
                            </Button>

                            <Button
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="{Binding RescrapeIdGamesToolTip}"
                                AutomationProperties.Name="{Binding RescrapeIdGames}"
                                Click="RescrapeIdGamesButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                ToolTipService.ToolTip="{Binding RescrapeIdGamesToolTip}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE71C;" />
                                    <TextBlock Text="{Binding RescrapeIdGames}" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                LineHeight="21"
                                Text="{x:Bind ViewModel.SelectedGame.Description, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Tags}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedGame.TagsText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding SourcePort}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.SourcePort, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Iwad}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.Iwad, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Playtime}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.Playtime, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding LastPlayed}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.LastPlayed, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PlayButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Play}"
                                    Click="PlayButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <ProgressRing
                                            Width="14"
                                            Height="14"
                                            IsActive="{x:Bind ViewModel.IsLaunching, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.LaunchingVisibility, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.LaunchButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <DropDownButton
                                    Grid.Column="1"
                                    AutomationProperties.Name="{Binding LaunchOptions}"
                                    Click="LaunchOptionsButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                    ToolTipService.ToolTip="{Binding LaunchOptions}">
                                    <DropDownButton.Content>
                                        <FontIcon Glyph="&#xE713;" />
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <Flyout x:Name="LaunchOptionsFlyout">
                                            <StackPanel Width="340" Spacing="12">
                                                <Grid>
                                                    <TextBlock
                                                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding LaunchOptions}" />
                                                    <ProgressRing
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Right"
                                                        IsActive="{x:Bind ViewModel.IsLaunchOptionsLoading, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.LaunchOptionsLoadingVisibility, Mode=OneWay}" />
                                                </Grid>
                                                <ComboBox
                                                    AutomationProperties.Name="{Binding SourcePort}"
                                                    DisplayMemberPath="Name"
                                                    Header="{Binding SourcePort}"
                                                    ItemsSource="{x:Bind ViewModel.SourcePortOptions, Mode=OneWay}"
                                                    SelectedItem="{x:Bind ViewModel.SelectedSourcePortOption, Mode=TwoWay}" />
                                                <ComboBox
                                                    AutomationProperties.Name="{Binding Iwad}"
                                                    DisplayMemberPath="Name"
                                                    Header="{Binding Iwad}"
                                                    ItemsSource="{x:Bind ViewModel.IwadOptions, Mode=OneWay}"
                                                    SelectedItem="{x:Bind ViewModel.SelectedIwadOption, Mode=TwoWay}" />
                                                <ComboBox
                                                    AutomationProperties.Name="{Binding Map}"
                                                    DisplayMemberPath="Name"
                                                    Header="{Binding Map}"
                                                    ItemsSource="{x:Bind ViewModel.MapOptions, Mode=OneWay}"
                                                    SelectedItem="{x:Bind ViewModel.SelectedMapOption, Mode=TwoWay}" />
                                                <ComboBox
                                                    AutomationProperties.Name="{Binding Difficulty}"
                                                    DisplayMemberPath="Name"
                                                    Header="{Binding Difficulty}"
                                                    ItemsSource="{x:Bind ViewModel.SkillOptions, Mode=OneWay}"
                                                    SelectedItem="{x:Bind ViewModel.SelectedSkillOption, Mode=TwoWay}" />
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding LaunchWithSelection}"
                                                    Click="LaunchWithOptionsButton_Click"
                                                    IsEnabled="{x:Bind ViewModel.CanLaunchWithOptions, Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                                        <TextBlock Text="{Binding LaunchWithSelection}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,24,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.HomeVisibility, Mode=OneWay}">
                <StackPanel Spacing="22">
                    <StackPanel
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <FontIcon
                            VerticalAlignment="Center"
                            Glyph="&#xE8A9;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding TileSize}" />
                        <Slider
                            Width="180"
                            AutomationProperties.Name="{Binding TileSize}"
                            Maximum="280"
                            Minimum="144"
                            StepFrequency="8"
                            Value="{Binding CardWidth, Source={StaticResource TileLayout}, Mode=OneWay}"
                            ValueChanged="TileSizeSlider_ValueChanged" />
                    </StackPanel>

                    <Grid Height="360" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.65*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Click="OverviewButton_Click"
                            ContextFlyout="{StaticResource LibraryItemContextMenu}"
                            Style="{StaticResource ShowcaseButtonStyle}"
                            Tag="{x:Bind ViewModel.HomeHero, Mode=OneWay}">
                            <Grid>
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{x:Bind ViewModel.HomeHero.DetailArtwork, Mode=OneWay}"
                                    Stretch="{x:Bind ViewModel.HomeHero.ArtworkStretch, Mode=OneWay}" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.25" Color="#12000000" />
                                            <GradientStop Offset="1" Color="#F0000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Border
                                    Margin="22"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource DoomControlAccentStrongBrush}"
                                    CornerRadius="13">
                                    <TextBlock
                                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Featured}" />
                                </Border>
                                <StackPanel
                                    Margin="24"
                                    VerticalAlignment="Bottom"
                                    Spacing="5">
                                    <TextBlock
                                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                        FontSize="30"
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{x:Bind ViewModel.HomeHero.Title, Mode=OneWay}"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="#D9FFFFFF"
                                        FontSize="15"
                                        MaxLines="1"
                                        Text="{x:Bind ViewModel.HomeHero.Subtitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock
                                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                            FontWeight="SemiBold"
                                            Text="{Binding ExploreNow}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel
                                    Margin="0,22,22,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="{ThemeResource DoomControlAccentBrush}"
                                        CornerRadius="16"
                                        Visibility="{x:Bind ViewModel.HomeHero.FavoriteBadgeVisibility, Mode=OneWay}">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE735;" />
                                    </Border>
                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="{ThemeResource DoomSuccessBrush}"
                                        CornerRadius="16"
                                        Visibility="{x:Bind ViewModel.HomeHero.FinishedBadgeVisibility, Mode=OneWay}">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE73E;" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <ItemsControl
                            Grid.Column="1"
                            ItemTemplate="{StaticResource HomeSpotlightTemplate}"
                            ItemsSource="{x:Bind ViewModel.HomeSpotlights, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.HomeGroups, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryGroup">
                                <StackPanel Margin="0,0,0,18" Spacing="8">
                                    <TextBlock
                                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}" />
                                    <GridView
                                        Height="{Binding PanelItemHeight, Source={StaticResource TileLayout}}"
                                        IsItemClickEnabled="True"
                                        ItemContainerStyle="{StaticResource RoundedTileItemStyle}"
                                        ItemClick="OverviewGrid_ItemClick"
                                        ItemTemplate="{StaticResource LibraryTileTemplate}"
                                        ItemsSource="{x:Bind Items}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollMode="Enabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        SelectionMode="None">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid
                        ColumnSpacing="16"
                        Visibility="{x:Bind ViewModel.HomeIwadGroupsVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{Binding ModsByGame}" />
                        <Border
                            Grid.Column="1"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{StaticResource DoomStrokeBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.HomeIwadGroups, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryGroup">
                                <StackPanel Margin="0,0,0,18" Spacing="8">
                                    <TextBlock
                                        FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}" />
                                    <GridView
                                        Height="{Binding PanelItemHeight, Source={StaticResource TileLayout}}"
                                        IsItemClickEnabled="True"
                                        ItemContainerStyle="{StaticResource RoundedTileItemStyle}"
                                        ItemClick="OverviewGrid_ItemClick"
                                        ItemTemplate="{StaticResource LibraryTileTemplate}"
                                        ItemsSource="{x:Bind Items}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollMode="Enabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        SelectionMode="None">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid
                Grid.Row="2"
                Visibility="{x:Bind ViewModel.CollectionsVisibility, Mode=OneWay}">
                <Grid
                    x:Name="CollectionGridHost"
                    Visibility="Collapsed">
                    <Grid x:Name="CollectionOverviewHost">
                        <GridView
                            IsItemClickEnabled="True"
                            ItemContainerStyle="{StaticResource RoundedTileItemStyle}"
                            ItemClick="CollectionGroupGrid_ItemClick"
                            ItemsSource="{x:Bind ViewModel.CollectionGroups, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        ItemHeight="{Binding PanelItemHeight, Source={StaticResource TileLayout}}"
                                        ItemWidth="{Binding PanelItemWidth, Source={StaticResource TileLayout}}"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:LibraryGroup">
                                    <Grid
                                        Width="{Binding CardWidth, Source={StaticResource TileLayout}}"
                                        Height="{Binding CardHeight, Source={StaticResource TileLayout}}"
                                        ToolTipService.ToolTip="{x:Bind Title}">
                                        <Button
                                            Padding="0"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Click="CollectionCardButton_Click"
                                            Style="{StaticResource ShowcaseButtonStyle}"
                                            Tag="{x:Bind Self}">
                                            <Border
                                                Background="{StaticResource DoomSurfaceBrush}"
                                                CornerRadius="12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Binding ArtworkHeight, Source={StaticResource TileLayout}}" />
                                                        <RowDefinition Height="112" />
                                                    </Grid.RowDefinitions>
                                                    <Border
                                                        Background="#FF111111"
                                                        CornerRadius="12,12,0,0">
                                                        <Grid>
                                                            <Image
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                Source="Assets/Library/collection_placeholder.jpg"
                                                                Stretch="UniformToFill" />
                                                            <Image
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                Source="{x:Bind CustomArtwork}"
                                                                Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Grid
                                                        Grid.Row="1"
                                                        Padding="14,10"
                                                        ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="44" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                                                FontSize="17"
                                                                FontWeight="SemiBold"
                                                                MaxLines="1"
                                                                Text="{x:Bind Title}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Style="{StaticResource MetaTextStyle}"
                                                                    Text="{x:Bind ProgressToolTip}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind ProgressText}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Button>
                                            <Button
                                                Width="38"
                                                Height="38"
                                                Margin="0,0,10,37"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.Name="{Binding DataContext.ChooseCollectionArtwork, ElementName=RootPage}"
                                                Click="CollectionArtworkButton_Click"
                                                Tag="{x:Bind Self}"
                                                ToolTipService.ToolTip="{Binding DataContext.ChooseCollectionArtwork, ElementName=RootPage}"
                                                Visibility="{x:Bind MissingArtworkActionVisibility}">
                                                <FontIcon FontSize="15" Glyph="&#xE91B;" />
                                            </Button>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <Grid
                        x:Name="CollectionDetailHost"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,18,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="42"
                                Height="42"
                                Padding="0"
                                AutomationProperties.Name="{Binding Collections}"
                                Click="CollectionBackButton_Click"
                                ToolTipService.ToolTip="{Binding Collections}">
                                <FontIcon Glyph="&#xE72B;" />
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="CollectionDetailTitle"
                                    FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                    FontSize="22"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="CollectionDetailProgress"
                                    Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Height="40"
                                    Padding="12,6"
                                    AutomationProperties.Name="{Binding ChooseCollectionArtwork}"
                                    Click="CollectionDetailArtworkButton_Click"
                                    ToolTipService.ToolTip="{Binding ChooseCollectionArtwork}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="15" Glyph="&#xE91B;" />
                                        <TextBlock Text="{Binding ChooseCollectionArtwork}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="CollectionDetailRemoveArtworkButton"
                                    Height="40"
                                    Padding="12,6"
                                    AutomationProperties.Name="{Binding RemoveCollectionArtwork}"
                                    Click="CollectionDetailRemoveArtworkButton_Click"
                                    ToolTipService.ToolTip="{Binding RemoveCollectionArtwork}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="15" Glyph="&#xE74D;" />
                                        <TextBlock Text="{Binding RemoveCollectionArtwork}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid
                                x:Name="CollectionDetailGridHost"
                                ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="350" />
                                </Grid.ColumnDefinitions>
                                <GridView
                                    x:Name="CollectionDetailGameGrid"
                                    IsItemClickEnabled="True"
                                    ItemContainerStyle="{StaticResource RoundedTileItemStyle}"
                                    ItemClick="CollectionDetailGameGrid_ItemClick"
                                    ItemTemplate="{StaticResource LibraryTileTemplate}"
                                    SelectionChanged="CollectionDetailGameGrid_SelectionChanged"
                                    SelectionMode="Single">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid
                                                ItemHeight="{Binding PanelItemHeight, Source={StaticResource TileLayout}}"
                                                ItemWidth="{Binding PanelItemWidth, Source={StaticResource TileLayout}}"
                                                Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                                <local:GameDetailsPane
                                    Grid.Column="1"
                                    ViewModel="{x:Bind ViewModel}"
                                    EditRequested="EditButton_Click"
                                    FavoriteRequested="FavoriteButton_Click"
                                    FinishedRequested="FinishedButton_Click"
                                    LaunchOptionsRequested="LaunchOptionsButton_Click"
                                    LaunchWithOptionsRequested="LaunchWithOptionsButton_Click"
                                    ManageCollectionsRequested="ManageCollectionsButton_Click"
                                    PlayRequested="PlayButton_Click"
                                    RescrapeRequested="RescrapeIdGamesButton_Click" />
                            </Grid>

                            <Grid
                                x:Name="CollectionDetailListHost"
                                ColumnSpacing="20"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="350" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Enabled">
                                    <StackPanel>
                                    <Grid
                                        MinHeight="38"
                                        Padding="8,0"
                                        Background="{StaticResource DoomSurfaceElevatedBrush}"
                                        Loaded="CollectionColumnGrid_Loaded"
                                        Tag="CollectionColumnGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ArtworkWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding TitleWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding AuthorWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding ReleaseDateWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding MapsWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding RatingWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding DownloadedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding SourcePortWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding PlaytimeWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                            <ColumnDefinition Width="{Binding FinishedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Artwork, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Title, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="2" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Author, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="3" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.ReleaseDate, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="4" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Maps, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="5" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Rating, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="6" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Downloaded, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="7" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.SourcePort, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="8" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Playtime, ElementName=RootPage}" />
                                        <TextBlock Grid.Column="9" Margin="7,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Finished, ElementName=RootPage}" />
                                    </Grid>
                                    <ListView
                                        x:Name="CollectionDetailGameList"
                                        HorizontalContentAlignment="Left"
                                        ItemTemplate="{StaticResource CollectionListRowTemplate}"
                                        SelectionChanged="CollectionDetailGameList_SelectionChanged"
                                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        SelectionMode="Single">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <ListViewItemPresenter
                                                                Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                ContentMargin="0"
                                                                CornerRadius="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                                                                PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                                                SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                                                SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                                                                SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                                                                SelectionIndicatorBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                                                SelectionIndicatorPointerOverBrush="{ThemeResource ListViewItemSelectionIndicatorPointerOverBrush}"
                                                                SelectionIndicatorPressedBrush="{ThemeResource ListViewItemSelectionIndicatorPressedBrush}"
                                                                SelectionIndicatorVisualEnabled="True"
                                                                VerticalContentAlignment="Center" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                    </StackPanel>
                                </ScrollViewer>
                                <local:GameDetailsPane
                                    Grid.Column="1"
                                    ViewModel="{x:Bind ViewModel}"
                                    EditRequested="EditButton_Click"
                                    FavoriteRequested="FavoriteButton_Click"
                                    FinishedRequested="FinishedButton_Click"
                                    LaunchOptionsRequested="LaunchOptionsButton_Click"
                                    LaunchWithOptionsRequested="LaunchWithOptionsButton_Click"
                                    ManageCollectionsRequested="ManageCollectionsButton_Click"
                                    PlayRequested="PlayButton_Click"
                                    RescrapeRequested="RescrapeIdGamesButton_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <ScrollViewer
                    x:Name="CollectionListHost"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Margin="0,0,18,0"
                        ItemsSource="{x:Bind ViewModel.CollectionGroups, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryGroup">
                                <Border
                                    Margin="{Binding CardMargin, Source={StaticResource AccordionDensityLayout}}"
                                    Background="{StaticResource DoomSurfaceBrush}"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    Loaded="CollectionAccordion_Loaded"
                                    Tag="{x:Bind Title}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            MinHeight="{Binding HeaderMinHeight, Source={StaticResource AccordionDensityLayout}}"
                                            Padding="{Binding HeaderPadding, Source={StaticResource AccordionDensityLayout}}"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Background="{StaticResource DoomSurfaceElevatedBrush}"
                                            BorderThickness="0"
                                            Click="CollectionAccordionHeader_Click"
                                            CornerRadius="11,11,0,0"
                                            Tag="{x:Bind Title}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    x:Name="CollectionAccordionChevron"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="13"
                                                    Glyph="&#xE70E;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                                    FontSize="{Binding TitleFontSize, Source={StaticResource AccordionDensityLayout}}"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MetaTextStyle}"
                                                    Text="{x:Bind ProgressText}"
                                                    ToolTipService.ToolTip="{x:Bind ProgressToolTip}" />
                                            </Grid>
                                        </Button>
                                        <Grid
                                            x:Name="CollectionAccordionContent"
                                            Grid.Row="1"
                                            MinHeight="1">
                                            <ScrollViewer
                                                HorizontalScrollBarVisibility="Auto"
                                                HorizontalScrollMode="Enabled"
                                                VerticalScrollBarVisibility="Disabled"
                                                VerticalScrollMode="Disabled">
                                                <StackPanel>
                                                    <Grid
                                                        MinHeight="38"
                                                        Padding="12,0"
                                                        ColumnSpacing="0"
                                                        Background="{StaticResource DoomSurfaceBrush}"
                                                        Loaded="CollectionColumnGrid_Loaded"
                                                        Tag="CollectionColumnGrid">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding ArtworkWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding TitleWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding AuthorWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding ReleaseDateWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding MapsWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding RatingWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding DownloadedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding SourcePortWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding PlaytimeWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                            <ColumnDefinition Width="{Binding FinishedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Artwork, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Title, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="2" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Author, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="3" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.ReleaseDate, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="4" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Maps, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="5" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Rating, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="6" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Downloaded, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="7" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.SourcePort, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="8" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Playtime, ElementName=RootPage}" />
                                                        <TextBlock Grid.Column="9" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Finished, ElementName=RootPage}" />
                                                    </Grid>
                                                    <ListView
                                                        HorizontalContentAlignment="Left"
                                                        IsItemClickEnabled="True"
                                                        ItemClick="CollectionOverviewGame_ItemClick"
                                                        ItemsSource="{x:Bind Items}"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                        ScrollViewer.VerticalScrollMode="Disabled"
                                                        SelectionMode="None">
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="MinHeight" Value="0" />
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0" />
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:LibraryItem">
                                                                <Grid
                                                                    MinHeight="{Binding RowMinHeight, Source={StaticResource ListDensityLayout}}"
                                                                    Padding="{Binding CollectionRowPadding, Source={StaticResource ListDensityLayout}}"
                                                                    ContextFlyout="{StaticResource LibraryItemContextMenu}"
                                                                    ColumnSpacing="0"
                                                                    Loaded="CollectionColumnGrid_Loaded"
                                                                    Tag="CollectionColumnGrid"
                                                                    Opacity="{x:Bind FinishedOpacity, Mode=OneWay}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding ArtworkWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding TitleWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding AuthorWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding ReleaseDateWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding MapsWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding RatingWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding DownloadedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding SourcePortWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding PlaytimeWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                        <ColumnDefinition Width="{Binding FinishedWidth, Source={StaticResource CollectionListColumnLayout}}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border
                                                                        Width="{Binding ArtworkWidth, Source={StaticResource ListDensityLayout}}"
                                                                        Height="{Binding ArtworkHeight, Source={StaticResource ListDensityLayout}}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="7">
                                                                        <Border.Background>
                                                                            <ImageBrush
                                                                                AlignmentX="Center"
                                                                                AlignmentY="Center"
                                                                                ImageSource="{x:Bind Artwork}"
                                                                                Stretch="{x:Bind ArtworkStretch}" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" FontFamily="{StaticResource DoomHeadlineFontFamily}" FontSize="12" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Author}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="3" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding ReleaseDate, Mode=OneWay}" />
                                                                    <TextBlock Grid.Column="4" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Maps}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="5" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Rating}" />
                                                                    <TextBlock Grid.Column="6" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{Binding Downloaded, Mode=OneWay}" />
                                                                    <TextBlock Grid.Column="7" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind SourcePort}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="8" Margin="7,0" VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" Text="{x:Bind Playtime}" />
                                                                    <CheckBox
                                                                        Grid.Column="9"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Click="FinishedCheckBox_Click"
                                                                        IsChecked="{x:Bind IsFinished, Mode=OneWay}"
                                                                        Tag="{x:Bind GameFileId}">
                                                                        <CheckBox.Resources>
                                                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource DoomSuccessColor}" />
                                                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource DoomSuccessColor}" />
                                                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource DoomSuccessColor}" />
                                                                        </CheckBox.Resources>
                                                                    </CheckBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid
                Grid.Row="2"
                Visibility="{x:Bind ViewModel.DiscoverVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.IdGamesStatus, Mode=OneWay}" />
                    <ProgressRing
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Right"
                        IsActive="{x:Bind ViewModel.IsDiscoverLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.DiscoverLoadingVisibility, Mode=OneWay}" />
                </Grid>
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.DiscoverItems, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:IdGamesItem">
                            <Border
                                Padding="18"
                                Background="{StaticResource DoomSurfaceBrush}"
                                BorderThickness="0"
                                CornerRadius="12">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Author}" />
                                        <Border
                                            Width="42"
                                            Height="1"
                                            Margin="0,3,0,2"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource TextFillColorSecondaryBrush}"
                                            Opacity="0.42" />
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="12" Glyph="&#xE787;" />
                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Date, ElementName=RootPage}" />
                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{x:Bind ReleaseDateText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="12" Glyph="&#xE734;" />
                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Rating, ElementName=RootPage}" />
                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{x:Bind RatingText}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MetaTextStyle}" Text="{x:Bind SizeText}" />
                                            <TextBlock Style="{StaticResource MetaTextStyle}" Text="{x:Bind FileName}" />
                                        </StackPanel>
                                        <TextBlock
                                            MaxLines="3"
                                            Text="{x:Bind Description}"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        MinWidth="126"
                                        VerticalAlignment="Bottom"
                                        Click="IdGamesDownloadButton_Click"
                                        IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Tag="{x:Bind Self}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{x:Bind ActionGlyph, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind ActionText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <Grid MinHeight="56">
                            <Button
                                MinWidth="150"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="{Binding LoadMore}"
                                Click="LoadMoreDiscoverButton_Click"
                                Content="{Binding LoadMore}"
                                IsEnabled="{x:Bind ViewModel.CanLoadMoreDiscover, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.LoadMoreDiscoverVisibility, Mode=OneWay}" />
                        </Grid>
                    </ListView.Footer>
                </ListView>
            </Grid>

            <ScrollViewer
                Grid.Row="2"
                Padding="0,0,18,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding ViewModel.AchievementsVisibility, ElementName=RootPage}">
                    <StackPanel Spacing="24">
                    <ItemsControl ItemsSource="{Binding ViewModel.AchievementSummary, ElementName=RootPage}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="245"
                                    MinHeight="112"
                                    Margin="0,0,14,14"
                                    Padding="18,15"
                                    Background="{StaticResource DoomSurfaceElevatedBrush}"
                                    CornerRadius="12">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{ThemeResource DoomSuccessLowBrush}"
                                            CornerRadius="10">
                                            <FontIcon
                                                Foreground="{ThemeResource DoomSuccessBrush}"
                                                Glyph="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding Label}" />
                                            <TextBlock
                                                FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                                FontSize="24"
                                                FontWeight="SemiBold"
                                                Text="{Binding Value}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ViewModel.AchievementGroups, ElementName=RootPage}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8" Spacing="10">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Width="320"
                                                    MinHeight="198"
                                                    Margin="0,0,14,14"
                                                    Padding="18"
                                                    Background="{StaticResource DoomSurfaceElevatedBrush}"
                                                    CornerRadius="12"
                                                    Opacity="{Binding Opacity}">
                                                    <Grid RowSpacing="9">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <FontIcon
                                                                HorizontalAlignment="Left"
                                                                FontSize="24"
                                                                Foreground="{ThemeResource DoomSuccessBrush}"
                                                                Glyph="{Binding Glyph}" />
                                                            <FontIcon
                                                                HorizontalAlignment="Right"
                                                                Foreground="{ThemeResource DoomSuccessBrush}"
                                                                Glyph="&#xE73E;"
                                                                Visibility="{Binding UnlockedVisibility}" />
                                                        </Grid>
                                        <TextBlock
                                            Grid.Row="1"
                                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                        <Grid Grid.Row="3" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Value="{Binding ProgressPercent}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MetaTextStyle}"
                                                Text="{Binding ProgressText}" />
                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Style="{StaticResource SectionTitleStyle}"
                        Text="{Binding EntriesAndMapsByIwad}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.IwadStatistics, ElementName=RootPage}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="320"
                                    Margin="0,0,14,14"
                                    Padding="16"
                                    Background="{StaticResource DoomSurfaceElevatedBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontFamily="{StaticResource DoomHeadlineFontFamily}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Iwad}"
                                            TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Mods, ElementName=RootPage}" />
                                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Entries}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding DataContext.Maps, ElementName=RootPage}" />
                                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Maps}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Grid.Row="2"
                Padding="0,0,18,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.DebugVisibility, Mode=OneWay}">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left" Spacing="18">
                    <Border
                        Padding="18"
                        Background="{StaticResource DoomSurfaceElevatedBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource SectionTitleStyle}"
                                Text="{Binding DebugEnvironment}" />
                            <TextBlock
                                x:Name="DebugEnvironmentText"
                                FontFamily="Consolas"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="18"
                        Background="{StaticResource DoomSurfaceElevatedBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource SectionTitleStyle}"
                                Text="{Binding DebugTests}" />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,8"
                                    Click="DebugRefresh_Click"
                                    Content="{Binding DebugRefreshLibrary}" />
                                <Button
                                    Margin="0,0,8,8"
                                    Click="DebugDatabase_Click"
                                    Content="{Binding DebugCheckDatabase}" />
                                <Button
                                    Margin="0,0,8,8"
                                    Click="DebugRepairDatabase_Click"
                                    Content="{Binding DebugRepairDatabase}" />
                                <Button
                                    Margin="0,0,8,8"
                                    Click="DebugSourcePorts_Click"
                                    Content="{Binding DebugSourcePorts}" />
                                <Button
                                    Margin="0,0,8,8"
                                    Click="DebugAchievement_Click"
                                    Content="{Binding DebugAchievementNotification}" />
                            </StackPanel>
                            <Button
                                x:Name="DebugIdGamesRefreshButton"
                                HorizontalAlignment="Left"
                                Click="DebugIdGamesRefresh_Click"
                                Content="{Binding DebugRefreshIdGamesMetadata}" />
                            <TextBlock
                                x:Name="DebugOutputText"
                                FontFamily="Consolas"
                                Text="{Binding DebugReady}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Spacing="8">
                <InfoBar
                    x:Name="AchievementNotificationBar"
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Success" />
                <InfoBar
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="{Binding LibraryLoadFailed}" />
                <InfoBar
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasLaunchError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.LaunchErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="{Binding LaunchFailed}" />
                <InfoBar
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasLaunchStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.LaunchStatus, Mode=OneWay}"
                    Severity="Success"
                    Title="{Binding GameSession}" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Page>
